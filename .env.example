# Copy this file to .env and set your local values.
# Only the variables listed here are loaded from .env; other keys are ignored.
# HF_TOKEN is optional — the default embedding model is public.
HF_TOKEN=hf_your_token_here

# Optional: suppress non-critical Transformers load warnings
# TRANSFORMERS_VERBOSITY=error
# HF_HUB_DISABLE_PROGRESS_BARS=1
